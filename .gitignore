# ---- 大体积第三方依赖（本地放置，不入库）----
# ffmpeg / exiftool：直接放进仓库目录即可被后端自动发现
ffmpeg/
exiftool/

# AI 运行时与模型：约 7.4 GB，用「补齐 AI 依赖与模型」下载或自行放置
AI/

# Python 依赖（零污染安装在 后端/libs/，不写系统环境）
后端/libs/

# ---- 运行时产物 ----
# 用户配置（含 API 密钥，绝不入库；模板见 后端/config.example.json）
config.json
config.json.bak*
config.json.tmp
data/
logs/
.cache/

# ---- 素材视频（本地测试用，体积大，不入库）----
视频/
*.mp4
*.mov
*.mkv
*.avi
*.flv
*.wmv
*.webm

# ---- 调试与截图产物 ----
.shots/
.tools/
视频图片/

# 本机上的独立小工具（Claude Code 面板汉化），与视频重命名无关，不入库
汉化面板/

# ---- Python ----
# start.bat 自己下载的便携版解释器（整个目录都在项目里，不入库）
python/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- 系统与编辑器杂项 ----
Thumbs.db
Desktop.ini
.DS_Store
*.log
.idea/
.vscode/
